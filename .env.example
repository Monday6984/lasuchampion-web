# Copy to .env for local development. On Vercel, add these under Project → Settings → Environment Variables.

# Neon Postgres connection string (Neon dashboard → Connection details → "Pooled connection")
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# Long random string used to sign logins. Generate one with: openssl rand -hex 32
PAYLOAD_SECRET=

# The public address of the site, no trailing slash
NEXT_PUBLIC_SITE_URL=https://lasuchampion.com
# Optional: extra addresses the admin may be used on (comma-separated). The main domain with and
# without www and the Vercel address are always allowed.
ADMIN_ORIGINS=

# Protects the daily job. Vercel sends it automatically to /api/cron/daily. Generate with: openssl rand -hex 32
CRON_SECRET=

# Cloudflare R2 (images and magazine PDFs). Leave empty locally to store uploads on disk instead.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=lasuchampion-media
# Public URL of the bucket: the r2.dev URL or a custom domain such as https://media.lasuchampion.com
R2_PUBLIC_URL=

# Resend (story alerts, the daily digest, password resets and enquiry alerts). Leave empty to skip sending (logged instead).
RESEND_API_KEY=
EMAIL_FROM=LASU Champion <news@mail.lasuchampion.com>
# Where readers' replies to the emails go (a real inbox)
EMAIL_REPLY_TO=lasuchampion@gmail.com
# Where new Advertise and Contact enquiries are emailed
ENQUIRY_NOTIFY_EMAIL=lasuchampion@gmail.com
# Emails sent per day across alerts, digest and invites (Resend free plan: 100 a day; 90 leaves room for resets and enquiry alerts)
DAILY_EMAIL_LIMIT=90

# Optional: Umami Cloud website id, for referrer and device stats on top of the built-in counts
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
